# ================================
# FRAME SYSTEM — Variáveis de Ambiente
# ================================

# Banco de dados
DATABASE_URL=postgresql://framesystem:framesystem@localhost:5432/framesystem

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_SECRET=sua_chave_secreta_aqui
JWT_SECRET=seu_jwt_secret_aqui

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_evolution_aqui

# n8n
N8N_WEBHOOK_URL=http://localhost:5678

# Chave interna para automações (n8n, cron jobs, etc.)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=troque-por-uma-chave-aleatoria-de-64-chars

# Upload de arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Ambiente
NODE_ENV=development
