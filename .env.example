# ================================
# FRAME SYSTEM — Variáveis de Ambiente
# ================================

# Banco de dados
DATABASE_URL=postgresql://framesystem:framesystem@localhost:5432/framesystem

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_SECRET=sua_chave_secreta_aqui
JWT_SECRET=seu_jwt_secret_aqui

# Claude (Anthropic) — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini Flash (gratuito) — aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_evolution_aqui

# n8n
N8N_WEBHOOK_URL=http://localhost:5678

# Chave interna para automações (n8n, cron jobs, etc.)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=troque-por-uma-chave-aleatoria-de-64-chars

# Upload de arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Obsidian (opcional) — notas de treinamento também são salvas como .md no vault
# Exemplo Windows: C:/Users/SeuNome/Documents/Obsidian/NutriAI
# Exemplo Linux/Mac: /home/usuario/Obsidian/NutriAI
OBSIDIAN_VAULT_PATH=

# Ambiente
NODE_ENV=development

# === AIOX Variables (added 2026-05-21) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
AIOX_VERSION=5.2.9

# AIOX_NOTE: The following variables already exist with different values:
# AIOX_SUGGESTED: ANTHROPIC_API_KEY=
# AIOX_SUGGESTED: N8N_WEBHOOK_URL=
