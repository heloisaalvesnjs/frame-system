{
  "name": "Frame System — 02 Lembrete de Consulta",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "frame-lembrete",
        "responseMode": "immediately",
        "responseCode": 200,
        "options": {}
      },
      "id": "trigger-lembrete",
      "name": "Recebe Lembrete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "frame-lembrete"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.event }}",
              "rightValue": "appointment_booked",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.event_subtype }}",
              "rightValue": "reminder_due",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "check-event",
      "name": "É lembrete de consulta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Recebe Lembrete').item.json.evolution_api_url }}/message/sendText/{{ $('Recebe Lembrete').item.json.instance_name }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Recebe Lembrete').item.json.evolution_api_key }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "number", "value": "={{ $('Recebe Lembrete').item.json.client_phone }}" },
            { "name": "text",   "value": "={{ $('Recebe Lembrete').item.json.message }}" }
          ]
        },
        "options": {}
      },
      "id": "send-lembrete",
      "name": "Envia lembrete no WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Recebe Lembrete": {
      "main": [[{ "node": "É lembrete de consulta?", "type": "main", "index": 0 }]]
    },
    "É lembrete de consulta?": {
      "main": [[{ "node": "Envia lembrete no WhatsApp", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "templateId": "frame-system-lembrete-v2",
    "description": "Recebe appointment_booked com event_subtype=reminder_due. O timing (24h antes) é gerenciado pelo servidor Frame System. A mensagem já vem pronta no campo 'message'. Payload flat na raiz do JSON."
  }
}
