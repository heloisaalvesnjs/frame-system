{
  "name": "Frame System — 03 Pós-Consulta",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "frame-pos-consulta",
        "responseMode": "immediately",
        "responseCode": 200,
        "options": {}
      },
      "id": "trigger-pos",
      "name": "Recebe Evento Pós-Consulta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "frame-pos-consulta"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.event }}",
              "rightValue": "pos_consulta_due",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "check-event",
      "name": "É pós-consulta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Recebe Evento Pós-Consulta').item.json.evolution_api_url }}/message/sendText/{{ $('Recebe Evento Pós-Consulta').item.json.instance_name }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Recebe Evento Pós-Consulta').item.json.evolution_api_key }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "number", "value": "={{ $('Recebe Evento Pós-Consulta').item.json.client_phone }}" },
            { "name": "text",   "value": "={{ $('Recebe Evento Pós-Consulta').item.json.message }}" }
          ]
        },
        "options": {}
      },
      "id": "send-pos",
      "name": "Envia mensagem pós-consulta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Recebe Evento Pós-Consulta": {
      "main": [[{ "node": "É pós-consulta?", "type": "main", "index": 0 }]]
    },
    "É pós-consulta?": {
      "main": [[{ "node": "Envia mensagem pós-consulta", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "templateId": "frame-system-pos-consulta-v2",
    "description": "Recebe pos_consulta_due. O timing (~3h após a consulta) e a mensagem já estão resolvidos pelo servidor Frame System. Apenas encaminha para Evolution API. Payload flat na raiz do JSON."
  }
}
