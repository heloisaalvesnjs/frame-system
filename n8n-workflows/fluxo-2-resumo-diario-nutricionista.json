      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Buscar nutricionistas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "jsCode": "const appointments = $('Consultas de hoje').first().json.appointments || [];\nconst nutritionists = $('Buscar nutricionistas').first().json.nutritionists || [];\n\nconst results = [];\n\nfor (const nutri of nutritionists) {\n  if (!nutri.instance_name || nutri.whatsapp_status !== 'connected') continue;\n\n  const minhasConsultas = appointments.filter(a => a.nutritionist_name === nutri.name);\n\n  const hoje = new Date().toLocaleDateString('pt-BR', {\n    weekday: 'long', day: '2-digit', month: 'long',\n    timeZone: 'America/Sao_Paulo'\n  });\n\n  let texto = `Bom dia! ☀️\\n\\nAqui está seu resumo de hoje, ${hoje}:\\n\\n`;\n\n  if (minhasConsultas.length === 0) {\n    texto += `📭 Nenhuma consulta agendada para hoje.\\n\\nBom descanso! 💚`;\n  } else {\n    texto += `📅 *${minhasConsultas.length} consulta(s) hoje:*\\n\\n`;\n    for (const appt of minhasConsultas) {\n      const hora = new Date(appt.scheduled_at).toLocaleTimeString('pt-BR', {\n        hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo'\n      });\n      const icone = appt.status === 'confirmed' ? '✅' : '🕐';\n      texto += `${icone} ${hora} — ${appt.client_name}\\n`;\n    }\n    texto += `\\nBom trabalho hoje! 💪💚`;\n  }\n\n  results.push({\n    json: {\n      instance_name: nutri.instance_name,\n      phone: nutri.whatsapp_number || nutri.phone,\n      text: texto\n    }\n  });\n}\n\nreturn results;"
      },
