# ================================
# FRAME SYSTEM — Variáveis de Ambiente (exemplo)
# Copie para .env e preencha com os valores reais.
# NUNCA commite o .env com valores reais.
# ================================

# ── Banco de dados ────────────────────────────────────────────
DATABASE_URL=postgresql://framesystem:framesystem@localhost:5432/framesystem

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=troque-por-um-secret-de-pelo-menos-64-chars

# URL pública da Frame API (usada em todo o sistema: CORS, webhooks, Google Calendar, n8n)
# Deve ser a URL acessível externamente — ex: https://api.framesystem.com.br
API_PUBLIC_URL=https://api.framesystem.com.br

# URL interna da Frame API (opcional) — usada SÓ no payload enviado ao n8n
# (campo internal_api_url), pra que as chamadas de volta do n8n pra API não
# passem pelo proxy público. Se a API e o n8n rodam no mesmo host/rede Docker
# (ex: EasyPanel), use o hostname interno do container — ex: http://nutriapp_api:3001
# Sem essa var, cai no API_PUBLIC_URL (funciona, mas sujeito a instabilidade de proxy).
API_INTERNAL_URL=http://nutriapp_api:3001

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_URL=https://app.framesystem.com.br

# ── Anthropic (Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── uazapi (WhatsApp) ─────────────────────────────────────────
# Base URL do servidor uazapi — ex: https://davidatendimento.uazapi.com
# No futuro multi-tenant, cada nutri pode ter seu próprio servidor.
UAZAPI_BASE_URL=https://seunome.uazapi.com

# Token de administrador do servidor uazapi (usado APENAS para criar novas instâncias).
# Obtido no painel de administração do servidor uazapi.
UAZAPI_ADMIN_TOKEN=seu-admin-token-aqui

# ── n8n ───────────────────────────────────────────────────────
# URL do webhook n8n que recebe mensagens do WhatsApp para processamento por IA.
# Se não configurado, o processamento cai no modo inline (ai.service.ts).
N8N_WEBHOOK_URL=https://n8n.seudominio.com/webhook/...

# ── Chave interna (Frame API ↔ n8n) ──────────────────────────
# Gerada com: openssl rand -hex 32
# Usada no header x-internal-key para autenticar chamadas /api/internal/*
INTERNAL_API_KEY=troque-por-um-secret-de-32-bytes-hex

# ── Google Calendar (opcional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Ambiente ──────────────────────────────────────────────────
NODE_ENV=production
